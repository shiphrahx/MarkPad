{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkPad",
  "version": "../package.json",
  "identifier": "com.shiphrah.markpad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkPad",
        "width": 900,
        "height": 680,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: markpad-image: http://markpad-image.localhost; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "shortDescription": "A Markdown editor for Windows, macOS and Linux.",
    "longDescription": "MarkPad opens a Markdown file as a document you type straight into, and saves it back as Markdown. Plain text in, plain text out. No vault, no database, no account, no sync, no telemetry.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.40)", "libgtk-3-0"],
        "desktopTemplate": "markpad.desktop",
        "section": "editors"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
