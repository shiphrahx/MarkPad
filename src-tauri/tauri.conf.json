{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkPad",
  "version": "0.1.1",
  "identifier": "com.shiphrah.markpad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkPad",
        "width": 900,
        "height": 680,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "A Markdown editor for Windows and macOS.",
    "longDescription": "MarkPad edits Markdown source. Plain text in, plain text out. No vault, no database, no account, no sync, no telemetry.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
